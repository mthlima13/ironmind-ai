# ============================================================
# IronMind AI — variáveis de ambiente de desenvolvimento
# Copie para `.env` e ajuste. NUNCA versionar o `.env` real.
#   cp .env.example .env
# ============================================================

# ---------- Backend: banco de dados ----------
# O MongoDB é um replica set de 1 nó porque o recálculo dos recordes usa
# transação de múltiplos documentos.
MONGODB_URI=mongodb://ironmind:changeme@localhost:27017/ironmind?authSource=admin&replicaSet=rs0

# ---------- Backend: identidade ----------
# Header injetado pelo gateway com o UUID do usuário autenticado. O backend não
# autentica ninguém: jamais exponha a porta da API diretamente na internet.
USER_UUID_HEADER=X-User-UUID

# ---------- Backend: CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:19007

# ---------- Backend: IA ----------
# "mock" responde de forma deterministica e nao gasta credito. Use "openai"
# somente com LLM_API_KEY e LLM_MODEL preenchidos.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=15000
LLM_MAX_OUTPUT_TOKENS=2000
LLM_DAILY_QUOTA_PER_USER=50
LLM_MAX_RETRIES=1
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_OPEN_SECONDS=30

# Limites das respostas estruturadas e orcamento por usuario.
AI_MAX_DAYS=7
AI_MAX_EXERCISES_PER_DAY=10
AI_MAX_SETS=8
AI_MAX_REPS=30
AI_MAX_REST_SECONDS=600
AI_MAX_CATALOG_EXERCISES=80
AI_DEFAULT_REPS_MIN=8
AI_DEFAULT_REPS_MAX=12
AI_DEFAULT_REST_SECONDS=90
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60

# ---------- Backend: ambiente ----------
SPRING_PROFILES_ACTIVE=local
LOG_LEVEL=INFO

# ---------- Docker Compose ----------
# Credenciais de desenvolvimento do MongoDB. Troque em qualquer ambiente real.
MONGO_INITDB_ROOT_USERNAME=ironmind
MONGO_INITDB_ROOT_PASSWORD=changeme
# Porta publicada no host. Use 27018 se 27017 ja estiver ocupada por um MongoDB local.
MONGO_PORT=27017
BACKEND_PORT=8080

# ---------- Mobile (publicado no bundle: SOMENTE valores nao secretos) ----------
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
EXPO_PUBLIC_USE_MOCKS=true
