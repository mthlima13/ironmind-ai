# ============================================================
# IronMind AI — variáveis de ambiente de desenvolvimento
# Copie para `.env` e ajuste. NUNCA versionar o `.env` real.
#   cp .env.example .env
# ============================================================

# ---------- Backend: banco de dados ----------
DB_URL=jdbc:postgresql://localhost:5432/ironmind
DB_USER=ironmind
DB_PASSWORD=changeme
DB_POOL_SIZE=10

# ---------- Backend: autenticação ----------
# Troque por um valor aleatorio de 32+ bytes antes de qualquer uso real.
# Gerar: openssl rand -base64 48
JWT_SECRET=change-me-32-bytes-minimum
JWT_TTL_SECONDS=900
JWT_ISSUER=ironmind-ai
JWT_REFRESH_TTL_SECONDS=2592000

# ---------- Backend: IA ----------
# "mock" responde de forma deterministica e nao gasta credito. Use "openai"
# somente com LLM_API_KEY e LLM_MODEL preenchidos.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=15000
LLM_MAX_OUTPUT_TOKENS=2000
LLM_DAILY_QUOTA_PER_USER=50
LLM_MAX_RETRIES=1
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_OPEN_SECONDS=30

# Limites das respostas estruturadas e orcamento por usuario.
AI_MAX_DAYS=7
AI_MAX_EXERCISES_PER_DAY=10
AI_MAX_SETS=8
AI_MAX_REPS=30
AI_MAX_REST_SECONDS=600
AI_MAX_CATALOG_EXERCISES=80
AI_DEFAULT_REPS_MIN=8
AI_DEFAULT_REPS_MAX=12
AI_DEFAULT_REST_SECONDS=90
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60

# ---------- Backend: ambiente ----------
SPRING_PROFILES_ACTIVE=local
LOG_LEVEL=INFO

# ---------- Backend: e-mail ----------
# A real provider must be configured outside development. In production the application
# fails fast if "logging" is used.
MAIL_PROVIDER=mailgun
# No Windows com Docker Desktop, o Testcontainers falha por incompatibilidade
# de API do engine; nesse caso aponte para o Postgres do docker-compose.
IT_JDBC_URL=
IT_JDBC_USER=ironmind
IT_JDBC_PASSWORD=changeme

# ---------- Mobile (publicado no bundle: SOMENTE valores nao secretos) ----------
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
EXPO_PUBLIC_USE_MOCKS=true
