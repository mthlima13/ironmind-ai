# ==========================================================
# IronMind AI - backend (variáveis de ambiente)
#
# Copie para `.env` e ajuste. NUNCA versionar o `.env` real.
# Todos os valores abaixo já são o padrão de desenvolvimento.
# ==========================================================

# ---------- Banco de dados ----------
DB_URL=jdbc:postgresql://localhost:5432/ironmind
DB_USER=ironmind
DB_PASSWORD=changeme
DB_POOL_SIZE=10

# ---------- Autenticação ----------
# Troque por um valor aleatório de 32+ bytes antes de qualquer uso real.
# Gerar: openssl rand -base64 48
JWT_SECRET=change-me-32-bytes-minimum
JWT_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=ironmind-ai

# ---------- CORS ----------
# Origens autorizadas a chamar a API (aplicativo publicado e clientes locais).
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:19007

# ---------- IA (Fase 2, Sprint 5) ----------
# A chave é lida apenas pelo backend e nunca chega ao aplicativo mobile.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=15000
LLM_MAX_OUTPUT_TOKENS=2000
LLM_DAILY_QUOTA_PER_USER=50

# ---------- Ambiente ----------
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
LOG_LEVEL=INFO

# ---------- E-mail ----------
MAIL_PROVIDER=logging
