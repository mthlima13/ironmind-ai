# ==========================================================
# IronMind AI - backend (variáveis de ambiente)
#
# Copie para `.env` e ajuste. NUNCA versionar o `.env` real.
# Todos os valores abaixo já são o padrão de desenvolvimento.
# ==========================================================

# ---------- Banco de dados (MongoDB) ----------
# O URI precisa apontar para um replica set: o recálculo dos recordes usa
# transação de múltiplos documentos. Em desenvolvimento, o compose sobe um
# replica set de um nó.
MONGODB_URI=mongodb://ironmind:changeme@localhost:27017/ironmind?authSource=admin&replicaSet=rs0

# Usuário e senha criados pelo container do MongoDB (usados pelo compose).
MONGO_INITDB_ROOT_USERNAME=ironmind
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_PORT=27017

# ---------- Identidade ----------
# O serviço não autentica: o gateway valida o token e injeta o UUID do
# usuário neste cabeçalho. Nunca aceite este cabeçalho de um cliente externo.
USER_UUID_HEADER=X-User-UUID

# ---------- CORS ----------
# Origens autorizadas a chamar a API (aplicativo publicado e clientes locais).
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:19007

# ---------- IA ----------
# A chave é lida apenas pelo backend e nunca chega ao aplicativo mobile.
# "mock" responde de forma determinística e não precisa de credencial.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=15000
LLM_MAX_OUTPUT_TOKENS=2000
LLM_DAILY_QUOTA_PER_USER=50

# ---------- Ambiente ----------
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
BACKEND_PORT=8080
LOG_LEVEL=INFO
