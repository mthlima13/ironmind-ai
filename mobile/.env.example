# Base URL of the IronFit REST API (SPEC 11 - prefix /api/v1).
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Set "true" to run the app without a backend: a built-in mock adapter speaks
# the same contracts as the real API (pagination, error format, idempotency).
# With "false" every request goes to EXPO_PUBLIC_API_URL, carrying the
# installing-device UUID on the X-User-UUID header (SPEC 6.4 and 11.1).
EXPO_PUBLIC_USE_MOCK_API=true

# Public URLs of the legal documents, shown in the settings screen (SPEC 14.4).
# Leave empty until the documents are published; the buttons stay hidden.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
