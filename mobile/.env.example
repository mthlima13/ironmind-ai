# Base URL of the IronMind AI REST API (SPEC 11 - prefix /api/v1).
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# When "false", the app talks to the real backend instead of the in-app mock adapter.
EXPO_PUBLIC_USE_MOCK_API=true

# Public URLs of the legal documents, shown in the profile screen (SPEC 14.4).
# Leave empty until the documents are published; the buttons stay hidden.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
