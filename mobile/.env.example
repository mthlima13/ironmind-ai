# Base URL of the IronFit REST API (SPEC 11 - prefix /api/v1).
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# The mobile app still uses the retired /auth/* contract. Keep "true" until the
# migration to the delegated identity header (X-User-UUID) is complete; with
# "false" login and profile fail against the current backend (SPEC 21).
EXPO_PUBLIC_USE_MOCK_API=true

# Public URLs of the legal documents, shown in the profile screen (SPEC 14.4).
# Leave empty until the documents are published; the buttons stay hidden.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
